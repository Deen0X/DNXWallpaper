{
  "schemaVersion": 2,
  "id": "pixabay",
  "name": "Pixabay",
  "version": "3.0.0",
  "description": "Imágenes y vídeos de Pixabay mediante su API oficial.",
  "author": "DNXWallpaperEngine",
  "license": "pixabay-content-license",
  "runtime": "python",
  "entry": "main.py",
  "icon": "icon.png",
  "capabilities": [
    "health",
    "categories",
    "list",
    "detail",
    "thumb",
    "fetch",
    "config"
  ],
  "mediaTypes": [
    "image",
    "video"
  ],
  "net": [
    "pixabay.com",
    "cdn.pixabay.com",
    "i.vimeocdn.com"
  ],
  "rateLimit": {
    "requestsPerMinute": 100,
    "burst": 10
  },
  "config": {
    "version": 1,
    "fields": [
      {
        "key": "apiKey",
        "label": "API key de Pixabay",
        "type": "secret",
        "required": true,
        "default": "",
        "help": "https://pixabay.com/api/docs/"
      }
    ]
  },
  "attribution": "Imágenes y vídeos de Pixabay y sus autores. Licencia de contenido Pixabay.",
  "redistributable": false,
  "protocol": 3
}
